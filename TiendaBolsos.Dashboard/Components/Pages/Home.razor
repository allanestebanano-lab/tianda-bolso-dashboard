@page "/"
@inject DashboardApiClient Api
@inject ProtectedSessionStorage SessionStorage

<PageTitle>Dashboard | TiendaBolsos</PageTitle>

@if (!_sessionReady)
{
    <p class="loading">Preparando el dashboard...</p>
}
else if (string.IsNullOrEmpty(Api.Token))
{
    <section class="login-card">
        <div class="eyebrow">Acceso seguro</div>
        <h1>Panel de analítica</h1>
        <p>Inicia sesión con una cuenta Admin o Gerente de la API.</p>
        <EditForm Model="_login" OnValidSubmit="LoginAsync">
            <label for="email">Correo</label>
            <InputText id="email" class="form-control" @bind-Value="_login.Correo" type="email" />
            <label for="password">Contraseña</label>
            <InputText id="password" class="form-control" @bind-Value="_login.Password" type="password" />
            <button class="primary-button" type="submit" disabled="@_isLoading">
                @(_isLoading ? "Ingresando..." : "Ingresar")
            </button>
        </EditForm>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="error-message" role="alert">@_error</p>
        }
    </section>
}
else
{
    <div class="dashboard-title">
        <div>
            <div class="eyebrow">Resumen del negocio y la plataforma</div>
            <h1>Dashboard</h1>
            <p>Los indicadores se actualizan con la última carga del Data Warehouse.</p>
        </div>
        <button class="secondary-button" @onclick="LogoutAsync">Cerrar sesión</button>
    </div>

    @if (_isLoading)
    {
        <p class="loading">Cargando indicadores...</p>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="error-panel" role="alert">
            <strong>No se pudieron cargar los indicadores.</strong>
            <span>@_error</span>
            <button class="secondary-button" @onclick="LoadDashboardAsync">Reintentar</button>
        </div>
    }
    else if (_business is not null && _technical is not null)
    {
        <section id="business" class="kpi-section">
            <h2>Indicadores del negocio</h2>
            <div class="kpi-grid">
                <KpiCard Label="Ventas acumuladas" Value="@_business.TotalSales.ToString("N2")" Icon="↗" />
                <KpiCard Label="Pedidos" Value="@_business.TotalOrders.ToString("N0")" Icon="▤" />
                <KpiCard Label="Ticket promedio" Value="@_business.AverageOrderValue.ToString("N2")" Icon="◉" />
                <KpiCard Label="Unidades vendidas" Value="@_business.UnitsSold.ToString("N0")" Icon="□" />
                <KpiCard Label="Productos con stock bajo" Value="@_business.LowStockProducts.ToString("N0")" Icon="!" />
            </div>
        </section>

        <section id="technical" class="kpi-section">
            <h2>Indicadores técnicos · últimas 24 horas</h2>
            <div class="kpi-grid technical-grid">
                <KpiCard Label="Solicitudes API" Value="@_technical.Requests.ToString("N0")" Icon="⌁" />
                <KpiCard Label="Errores 5xx" Value="@_technical.ServerErrors.ToString("N0")" Icon="!" />
                <KpiCard Label="Tasa de errores 5xx" Value="@($"{_technical.ServerErrorRatePercent:N2}%")" Icon="%" />
                <KpiCard Label="Latencia promedio" Value="@($"{_technical.AverageResponseMilliseconds:N0} ms")" Icon="◷" />
            </div>
        </section>

        <section class="chart-grid">
            <article class="chart-card">
                <h2>Ventas por día</h2>
                @if (_business.DailySales.Count == 0)
                {
                    <p class="empty-state">Aún no hay ventas cargadas para los últimos 7 días.</p>
                }
                else
                {
                    var maxSales = Math.Max(1m, _business.DailySales.Max(item => item.Amount));
                    <div class="bar-chart" aria-label="Ventas de los últimos siete días">
                        @foreach (var day in _business.DailySales)
                        {
                            <div class="bar-column" title="@day.Amount.ToString("N2")">
                                <span class="bar-value">@day.Amount.ToString("N0")</span>
                                <div class="bar business-bar" style="height:@($"{Math.Max(4m, day.Amount / maxSales * 100m):N0}%")"></div>
                                <span class="bar-label">@day.Date.ToString("dd MMM")</span>
                            </div>
                        }
                    </div>
                }
            </article>

            <article class="chart-card">
                <h2>Solicitudes API por día</h2>
                @if (_technical.DailyRequests.Count == 0)
                {
                    <p class="empty-state">Aún no hay telemetría técnica cargada.</p>
                }
                else
                {
                    var maxRequests = Math.Max(1, _technical.DailyRequests.Max(item => item.Requests));
                    <div class="bar-chart" aria-label="Solicitudes de API de los últimos siete días">
                        @foreach (var day in _technical.DailyRequests)
                        {
                            <div class="bar-column" title="@($"{day.Requests} solicitudes, {day.ServerErrors} errores")">
                                <span class="bar-value">@day.Requests</span>
                                <div class="bar request-bar" style="height:@($"{Math.Max(4, day.Requests * 100 / maxRequests)}%")"></div>
                                <span class="bar-label">@day.Date.ToString("dd MMM")</span>
                            </div>
                        }
                    </div>
                }
            </article>
        </section>
    }
}

@code {
    private readonly LoginModel _login = new();
    private BusinessDashboardModel? _business;
    private TechnicalDashboardModel? _technical;
    private bool _sessionReady;
    private bool _isLoading;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var storedToken = await SessionStorage.GetAsync<string>("analytics-token");
            if (storedToken.Success && !string.IsNullOrWhiteSpace(storedToken.Value))
            {
                Api.Token = storedToken.Value;
            }
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }

        _sessionReady = true;
        if (!string.IsNullOrEmpty(Api.Token))
        {
            await LoadDashboardAsync();
        }
        StateHasChanged();
    }

    private async Task LoginAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            Api.Token = await Api.LoginAsync(_login);
            await SessionStorage.SetAsync("analytics-token", Api.Token);
            await LoadDashboardAsync();
        }
        catch (HttpRequestException exception)
        {
            Api.Token = null;
            _error = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadDashboardAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            (_business, _technical) = await Api.GetDashboardAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized ||
                                                      exception.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            Api.Token = null;
            await SessionStorage.DeleteAsync("analytics-token");
            _business = null;
            _technical = null;
            _error = "La sesión expiró o la cuenta no tiene el rol Admin/Gerente. Inicia sesión de nuevo.";
        }
        catch (HttpRequestException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LogoutAsync()
    {
        Api.Token = null;
        await SessionStorage.DeleteAsync("analytics-token");
        _business = null;
        _technical = null;
        _error = null;
    }
}
